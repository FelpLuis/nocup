# Copie para config.env e ajuste.
# Token de API do Zabbix próprio (Usuários > Tokens de API). Precisa de leitura
# nos grupos "IXC" (host IXC - CTO), "GPON/ONUs" e "OLTs UpDown".
ZABBIX_URL=http://127.0.0.1:19090
ZABBIX_TOKEN=COLE_O_TOKEN_AQUI

# Nomes no Zabbix (já vêm com os nomes atuais)
CTO_HOST=IXC - CTO
ONU_GROUP=GPON/ONUs
OLT_GROUP=OLTs UpDown

# Servidor da tela
LISTEN=0.0.0.0
PORT=8445
POLL_SECONDS=30
# Login opcional para a tela (usuário:senha). Vazio = sem login.
BASIC_AUTH=

# Regras
PON_MIN_ONUS=2        # PON down se TODAS as ONUs monitoradas dela estiverem fora (com pelo menos N)
PON_MIN_CTOS=2        # PON down se TODAS as CTOs mapeadas nela estiverem sem cliente online (com pelo menos N)
CONFIRM_POLLS=1       # coletas seguidas com 0 sessões antes de mostrar a CTO (2 = mais resistente a falso positivo)
SHOW_PARTIAL=1        # mostra também "queda parcial" (problemas ativos com tag cto)
MASSIVE_MIN=5         # nº de CTOs down para acender a faixa de QUEDA MASSIVA
RECOVERED_KEEP=180    # segundos que um alerta normalizado fica na lista "Normalizadas"
# Nomes de exibição das OLTs (chave = valor do item onu.olt)
OLT_NAMES=casqueiro=C300 Casqueiro,vilanatal=C350 Vila Natal
