# Copie para config.env e ajuste.
# Token de API do Zabbix próprio (Usuários > Tokens de API). Precisa de leitura
# nos grupos "IXC" (host IXC - CTO), "GPON/ONUs" e "OLTs UpDown".
ZABBIX_URL=http://127.0.0.1:19090
ZABBIX_TOKEN=COLE_O_TOKEN_AQUI

# Nomes no Zabbix (já vêm com os nomes atuais)
CTO_HOST=IXC - CTO
ONU_GROUP=GPON/ONUs
OLT_GROUP=OLTs UpDown

# Servidor da tela
LISTEN=0.0.0.0
PORT=8445
POLL_SECONDS=30

# Login: usa os mesmos usuários do Painel das OLTs (/etc/painel-olt/users.json).
# Para criar/trocar senha: python3 /opt/painel-olt/painel-auth.py adduser NOME
LOGIN=1
USERS_FILE=/etc/painel-olt/users.json
# Contas extras só desta tela (opcional): usuario:senha,outro:senha
BASIC_AUTH=
# Duração da sessão: sem "manter conectado" (horas) e com ele (dias)
SESSION_HOURS=12
SESSION_TV_DAYS=90

# Regras
# "CTOs" do IXC que não são caixa de verdade e ficam fora da tela (separadas por vírgula)
CTO_IGNORAR=ERRO,CLIENTES FUSIONADOS,EQUIPAMENTO COM CLIENTE
# Mesmo critério do WhatsApp: a tela mostra só os problemas que as ações do Zabbix
# que enviam para esta mídia mandariam (lê as condições das ações automaticamente).
WPP_MEDIA=Wpp PON
# PON down = PON INTEIRA fora: porta DOWN na OLT e a PON tem cliente,
# ou TODAS as CTOs com cliente desta PON fora do ar (mínimo de CTOs abaixo)
PON_MIN_CTOS=2
# Queda parcial de CTO (alguns clientes): 0 = não mostra; a tela é só para queda inteira
SHOW_PARTIAL=0
# Segundos que um alerta normalizado fica na lista "Normalizadas"
RECOVERED_KEEP=180
# Nomes de exibição das OLTs (chave = valor do item onu.olt)
OLT_NAMES=casqueiro=C300 Casqueiro,vilanatal=C350 Vila Natal
