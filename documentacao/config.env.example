# Copie para config.env e ajuste.
# Token de API do Zabbix próprio (Usuários > Tokens de API) com LEITURA no grupo "Links UpDown"
# (onde ficam os roteadores, switches e DWDM). Pode ser o mesmo token do painel-pon.
ZABBIX_URL=http://127.0.0.1:19090
ZABBIX_TOKEN=COLE_O_TOKEN_AQUI
ZABBIX_VERIFY_TLS=1
# Minutos entre leituras do Zabbix (o botão "⟳ Zabbix" do site lê na hora)
SYNC_MINUTES=5

# Servidor do site (o nginx publica em https://documentacao.noc.updown.com.br)
LISTEN=127.0.0.1
PORT=8447
# Onde ficam a documentação, o cache do Zabbix e o histórico de versões
DATA_DIR=/opt/documentacao-noc/data
# Quantas versões anteriores manter em data/historico/
HISTORY_KEEP=200

# Login do site: usuário NOC. A senha fica só como hash (nunca em texto).
# O instalador gera uma senha aleatória na primeira instalação e mostra uma vez.
# Para trocar a senha: sudo -u www-data python3 /opt/documentacao-noc/server.py senha
# e cole a linha gerada aqui (depois: systemctl restart documentacao-noc)
# Sem hash, sem PORTAL=1 e com LOGIN=1 o site responde 503 (não abre sem login).
LOGIN=1
LOGIN_USUARIO=NOC
LOGIN_SENHA_HASH=
# Cookie de sessão com Secure: auto (quando o nginx repassa https) | 1 | 0
COOKIE_SECURE=auto
# Opcional: também aceitar os usuários do Painel das OLTs (vazio = só a conta NOC)
USERS_FILE=
# Contas extras só deste site (opcional): usuario:senha,outro:senha
BASIC_AUTH=
# Quem pode EDITAR (vazio = todo usuário com login). Os demais só consultam. Ex.: EDITORES=luis,ana
EDITORES=
SESSION_HOURS=12
SESSION_TV_DAYS=90

# Login único pelo Portal NOC (https://portal.updown.com.br): 1 = o usuário vem do portal
# (o nginx confere a sessão e as permissões). Quem liga é o vincular-portal.sh.
PORTAL=0
