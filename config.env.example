# Copie para config.env e ajuste.
# Token de API do Zabbix próprio (Usuários > Tokens de API) com LEITURA no grupo "Links UpDown"
# (onde ficam os roteadores, switches e DWDM). Pode ser o mesmo token do painel-pon.
ZABBIX_URL=http://127.0.0.1:19090
ZABBIX_TOKEN=COLE_O_TOKEN_AQUI
ZABBIX_VERIFY_TLS=1
# Minutos entre leituras do Zabbix (o botão "⟳ Zabbix" do site lê na hora)
SYNC_MINUTES=5

# Servidor do site (o nginx publica em https://documentacao.noc.updown.com.br)
LISTEN=127.0.0.1
PORT=8447
# Onde ficam a documentação, o cache do Zabbix e o histórico de versões
DATA_DIR=/opt/documentacao-noc/data
# Quantas versões anteriores manter em data/historico/
HISTORY_KEEP=200

# Login: mesmos usuários do Painel das OLTs (/etc/painel-olt/users.json).
# Para criar/trocar senha: python3 /opt/painel-olt/painel-auth.py adduser NOME
LOGIN=1
USERS_FILE=/etc/painel-olt/users.json
# Contas extras só deste site (opcional): usuario:senha,outro:senha
BASIC_AUTH=
# Quem pode EDITAR (vazio = todo usuário com login). Os demais só consultam. Ex.: EDITORES=luis,ana
EDITORES=
SESSION_HOURS=12
SESSION_TV_DAYS=90
